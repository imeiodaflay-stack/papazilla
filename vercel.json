{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build && cp apps/web/dist/index.html apps/web/dist/app.html && cp apps/web/dist/home.html apps/web/dist/index.html",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/termos",
      "destination": "/termos.html"
    },
    {
      "source": "/termos/",
      "destination": "/termos.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/privacidade/",
      "destination": "/privacidade.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "schedules": {
    "avisos-da-fornalha": {
      "schedule": "0 8 * * *",
      "timezone": "America/Sao_Paulo",
      "path": "/api/reminders-cron",
      "requestMethod": "GET"
    }
  }
}
