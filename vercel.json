{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build && cp apps/web/dist/index.html apps/web/dist/app.html && cp apps/web/dist/home.html apps/web/dist/index.html",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/termos",
      "destination": "/termos.html"
    },
    {
      "source": "/termos/",
      "destination": "/termos.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/privacidade/",
      "destination": "/privacidade.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
