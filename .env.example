# Papazilla — variáveis de ambiente
# Copie para .env.local (apps/web) e configure na Vercel por ambiente.
# NUNCA comitar valores reais. Este arquivo só documenta os nomes.

# --- Frontend (públicas, expostas no bundle) ---
# Supabase dev:  https://uwjgeydlsjnqnvgpoisc.supabase.co
# Supabase prod: https://zfssjgwhvlpoqlyyxmnu.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Servidor (Vercel Functions) — NUNCA no bundle do navegador ---
SUPABASE_SERVICE_ROLE_KEY=

# URL do próprio deploy, usada pelas funções para montar callbacks quando necessário
# (em produção a Vercel injeta VERCEL_URL automaticamente)
APP_URL=http://localhost:5173
