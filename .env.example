# Papazilla — variáveis de ambiente
# Copie para .env.local (apps/web) e configure na Vercel por ambiente.
# NUNCA comitar valores reais. Este arquivo só documenta os nomes.

# --- Frontend (públicas, expostas no bundle) ---
# Supabase dev:  https://uwjgeydlsjnqnvgpoisc.supabase.co
# Supabase prod: https://zfssjgwhvlpoqlyyxmnu.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Servidor (Vercel Functions) — NUNCA no bundle do navegador ---
SUPABASE_SERVICE_ROLE_KEY=

# URL do próprio deploy, usada pelas funções para montar callbacks quando necessário
# (em produção a Vercel injeta VERCEL_URL automaticamente)
APP_URL=http://localhost:5173

# --- Asaas (assinatura real — api/checkout-create.ts, api/webhooks-asaas.ts, api/subscription-cancel.ts) ---
# Chave de API do Asaas. Gerar em asaas.com > Integrações > API, uma pra
# sandbox (testes) e outra pra produção — NUNCA misturar as duas.
ASAAS_API_KEY=
# "production" usa https://api.asaas.com; qualquer outro valor (ou ausente)
# usa o sandbox (https://api-sandbox.asaas.com) — padrão sempre seguro.
ASAAS_ENV=sandbox
# Token que o Asaas devolve em todo webhook, no header `asaas-access-token`.
# Escolha um valor aleatório e cole o mesmo ao cadastrar o webhook no painel
# do Asaas (Integrações > Webhooks) apontando pra
# https://<seu-dominio>/api/webhooks-asaas — eventos: CHECKOUT_PAID,
# CHECKOUT_CANCELED, CHECKOUT_EXPIRED, PAYMENT_RECEIVED, PAYMENT_CONFIRMED,
# PAYMENT_OVERDUE.
ASAAS_WEBHOOK_TOKEN=
