# Papazilla — variáveis de ambiente
# Copie para .env.local (apps/web) e configure na Vercel por ambiente.
# NUNCA comitar valores reais. Este arquivo só documenta os nomes.

# --- Frontend (públicas, expostas no bundle) ---
# Supabase dev:  https://uwjgeydlsjnqnvgpoisc.supabase.co
# Supabase prod: https://zfssjgwhvlpoqlyyxmnu.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Servidor (Vercel Functions) — NUNCA no bundle do navegador ---
SUPABASE_SERVICE_ROLE_KEY=

# URL do próprio deploy, usada pelas funções para montar callbacks quando necessário
# (em produção a Vercel injeta VERCEL_URL automaticamente)
APP_URL=http://localhost:5173

# --- Asaas (assinatura real — api/checkout-create.ts, api/webhooks-asaas.ts, api/subscription-cancel.ts) ---
# Chave de API do Asaas. Gerar em asaas.com > Integrações > API, uma pra
# sandbox (testes) e outra pra produção — NUNCA misturar as duas.
ASAAS_API_KEY=
# "production" usa https://api.asaas.com; qualquer outro valor (ou ausente)
# usa o sandbox (https://api-sandbox.asaas.com) — padrão sempre seguro.
ASAAS_ENV=sandbox
# Token que o Asaas devolve em todo webhook, no header `asaas-access-token`.
# Escolha um valor aleatório e cole o mesmo ao cadastrar o webhook no painel
# do Asaas (Integrações > Webhooks) apontando pra
# https://<seu-dominio>/api/webhooks-asaas — eventos: CHECKOUT_CREATED,
# CHECKOUT_PAID, CHECKOUT_CANCELED, CHECKOUT_EXPIRED, SUBSCRIPTION_CREATED,
# PAYMENT_RECEIVED, PAYMENT_CONFIRMED, PAYMENT_OVERDUE. Configure o envio como
# sequencial. O token deve ter entre 32 e 255 caracteres e não pode ser a
# chave da API do Asaas.
ASAAS_WEBHOOK_TOKEN=

# --- Avisos (api/reminders-cron.ts, lib/reminders.ts) ---
# Web Push: gere o par com `npx web-push generate-vapid-keys` e use o MESMO par
# em todos os ambientes que compartilham o banco. A pública vai para o bundle.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo Web Push.
VAPID_SUBJECT=mailto:contato@papazilla.app
# E-mail pelo Resend (resend.com), com o domínio papazilla.app verificado.
RESEND_API_KEY=
REMINDER_EMAIL_FROM=Papazilla <avisos@papazilla.app>
# Endereço do app usado nos links dos avisos (sem barra no fim).
REMINDER_APP_URL=https://papazilla.app
# A Vercel manda este valor no header Authorization ao rodar o cron.
CRON_SECRET=
